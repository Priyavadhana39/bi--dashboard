# ============================================================================
# Database Configuration - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual database credentials
# NEVER commit the .env file to version control
# ============================================================================

# PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=procurement_intelligence
DB_USER=your_username
DB_PASSWORD=your_password

# Optional: Connection Pool Settings
DB_MIN_CONN=1
DB_MAX_CONN=10

# Optional: SSL Mode (disable, allow, prefer, require, verify-ca, verify-full)
DB_SSLMODE=prefer

# Optional: Connection Timeout (seconds)
DB_CONNECT_TIMEOUT=10

# ============================================================================
# AI Agent Configuration (Module 5)
# ============================================================================

# LLM Provider Configuration
# Supported providers: openai, gemini
LLM_PROVIDER=gemini

# Google Gemini Model
# Current supported model: gemini-3.8-flash
# Uses new Google GenAI SDK v2.29.0 with automatic function calling
LLM_MODEL=gemini-3.8-flash

# Google Gemini API Key
# Get your key from: https://aistudio.google.com/apikey
# Supports both AIza (legacy) and AQ (new authorization) key formats
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (alternative provider)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# RAG Configuration
EMBEDDING_MODEL=models/embedding-001
VECTOR_STORE_PATH=./agent/vector_store
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=3

# Agent Configuration
MAX_TOOL_CALLS=10
ENABLE_RAG=true

# Optional: Alternative LLM Providers
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
